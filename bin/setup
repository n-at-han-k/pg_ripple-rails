#!/bin/sh

set -e

gem install bundler --conservative
bundle check || bundle install

# The specs run against a real pg_ripple database — a stock postgres:18 will not
# do, and both extensions have to be installed by hand: CREATE EXTENSION
# pg_ripple does not pull pg_trickle in, and CASCADE does not either.
bundle exec rake dummy:db:drop
bundle exec rake dummy:db:create
